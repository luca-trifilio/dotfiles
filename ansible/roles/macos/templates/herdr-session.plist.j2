<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.lucatrifilio.herdr-{{ herdr_session_name }}</string>

  <key>ProgramArguments</key>
  <array>
    <string>{{ homebrew_prefix }}/bin/herdr</string>
    <string>server</string>
    <string>--session</string>
    <string>{{ herdr_session_name }}</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <!-- launchd's default PATH (/usr/bin:/bin:/usr/sbin:/sbin) hides every
       agent CLI (claude, opencode, etc.) from Herdr's Integrations panel,
       which shells out and checks PATH in THIS process, not the terminal's.
       Cover the common agent-CLI install locations explicitly. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>{{ ansible_env.HOME }}/.local/bin:{{ ansible_env.HOME }}/.bun/bin:{{ ansible_env.HOME }}/.opencode/bin:{{ ansible_env.HOME }}/go/bin:{{ ansible_env.HOME }}/.nix-profile/bin:{{ homebrew_prefix }}/bin:{{ homebrew_prefix }}/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StandardOutPath</key>
  <string>{{ ansible_env.HOME }}/Library/Logs/herdr-{{ herdr_session_name }}.log</string>
  <key>StandardErrorPath</key>
  <string>{{ ansible_env.HOME }}/Library/Logs/herdr-{{ herdr_session_name }}.log</string>
</dict>
</plist>
