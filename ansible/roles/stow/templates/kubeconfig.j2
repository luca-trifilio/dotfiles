# Managed by Ansible (roles/stow). DO NOT EDIT BY HAND.
# EKS contexts are common to both profiles. The homelab context is personal-only
# and its certs come from the SOPS vault (group_vars/personal/vault.sops.yaml).
apiVersion: v1
kind: Config
preferences: {}
current-context: services-eks-cluster-staging
clusters:
  - name: services-eks-cluster-test
    cluster:
        server: https://F87E457231F27A8CAD6E11484614DAC7.gr7.eu-west-1.eks.amazonaws.com
        certificate-authority-data: 
  - name: services-eks-cluster-staging
    cluster:
        server: https://F87E457231F27A8CAD6E11484614DAC7.gr7.eu-west-1.eks.amazonaws.com
        certificate-authority-data: 
{% if 'personal' in group_names and homelab_client_certificate_data is defined %}
  - name: homelab
    cluster:
        server: https://100.74.130.73:6443
        certificate-authority-data: 
{% endif %}
contexts:
  - name: services-eks-cluster-test
    context:
        cluster: services-eks-cluster-test
        user: services-eks-cluster-test
  - name: services-eks-cluster-staging
    context:
        cluster: services-eks-cluster-staging
        user: services-eks-cluster-staging
{% if 'personal' in group_names and homelab_client_certificate_data is defined %}
  - name: homelab
    context:
        cluster: homelab
        user: homelab
        namespace: homelab
{% endif %}
users:
  - name: services-eks-cluster-test
    user:
        exec:
            apiVersion: client.authentication.k8s.io/v1beta1
            command: aws
            args:
              - --region
              - eu-west-1
              - eks
              - get-token
              - --cluster-name
              - services-eks-cluster-test
              - --output
              - json
            env:
              - name: AWS_PROFILE
                value: staging
  - name: services-eks-cluster-staging
    user:
        exec:
            apiVersion: client.authentication.k8s.io/v1beta1
            command: aws
            args:
              - --region
              - eu-west-1
              - eks
              - get-token
              - --cluster-name
              - services-eks-cluster-staging
              - --output
              - json
            env:
              - name: AWS_PROFILE
                value: staging
{% if 'personal' in group_names and homelab_client_certificate_data is defined %}
  - name: homelab
    user:
        client-certificate-data: {{ homelab_client_certificate_data }}
        client-key-data: {{ homelab_client_key_data }}
{% endif %}
