{# Managed by Ansible (roles/stow). DO NOT EDIT BY HAND. #}
{# The API token is not stored here: the plugin reads HINDSIGHT_API_TOKEN from the env (zsh/secrets.zsh). #}
{
  "serverMode": "self-hosted",
  "apiUrl": {{ hindsight_api_url | to_json }},
  "bankId": {{ hindsight_bank_id | to_json }},
  "optInOnly": true,
  "optInPaths": {{ hindsight_opt_in_paths | to_json }},
  "retainSessions": true,
  "gitIngest": "none",
  "autoSeed": true,
  "codebaseSurvey": true,
  "autoInject": "reflect",
  "autoUpdate": true,
  "banks": {
    {{ hindsight_bank_id | to_json }}: {
      "manageBankConfig": true,
      "recallOptions": { "types": ["world", "experience"] }
    }
  },
  "toolGuideExtra": {{ hindsight_tool_guide_extra | to_json }},
  "paths": {
{% set entries = [] %}
{% for d in hindsight_disabled_paths %}
{% set _ = entries.append((d | to_json) ~ ': { "disabled": true }') %}
{% endfor %}
{% for p in hindsight_projects %}
{% set _ = entries.append((p.path | to_json) ~ ': { "retainTags": [' ~ (('project:' ~ p.name) | to_json) ~ '] }') %}
{% endfor %}
    {{ entries | join(",\n    ") }}
  }
}
